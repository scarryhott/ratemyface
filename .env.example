# Server-side only. Never expose these with NEXT_PUBLIC_ prefixes.
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
GPT_ACTION_SECRET=

# Rate My Face OAuth bridge
RMF_OAUTH_CLIENT_ID=ratemyface-chatgpt
RMF_OAUTH_CLIENT_SECRET=
CHATGPT_OAUTH_REDIRECT_URI=

# Supabase / Postgres (normally injected by the Vercel integration)
DATABASE_URL=
POSTGRES_URL=
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe billing — server-side only
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_CREDITS=
RMF_CREDITS_PER_PACK=100
# Optional one-time non-purchase OAuth bootstrap via grantCredits (0 disables). Default 100.
RMF_SIGNUP_CREDITS=100
STRIPE_PRICE_ID_PREMIUM=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
STRIPE_PORTAL_RETURN_URL=

# Closure-native builder operator
AI_GATEWAY_API_KEY=
RMF_OPERATOR_MODEL=openai/gpt-5.6-terra
# Hard security ceiling. Starts analysis-only; use 2 only when intentionally testing isolated branch control.
RMF_OPERATOR_MAX_AUTHORITY=1
# Random bearer secret for external/email/manual signal ingress and status reads.
RMF_OPERATOR_SIGNAL_SECRET=
# Vercel Cron bearer secret used for the heartbeat endpoint.
CRON_SECRET=

# Owner identity allowlist. Configure only the identities you want to accept.
# Google/social identity is authorized by exact email match after Supabase verifies the session.
RMF_OPERATOR_OWNER_EMAIL=
# Phone must be in international/E.164 form, e.g. +15555555555. Requires Supabase Phone Auth + an SMS provider.
RMF_OPERATOR_OWNER_PHONE=
# Lower/upper case is normalized for Ethereum addresses. Supabase Web3 Auth must be enabled.
RMF_OPERATOR_OWNER_ETH_ADDRESS=
# Solana public key allowlist. Supabase Web3 Auth must be enabled.
RMF_OPERATOR_OWNER_SOL_ADDRESS=

# GitHub operator target. Reads work for the public repository without a token.
RMF_OPERATOR_GITHUB_REPO=scarryhott/ratemyface
RMF_OPERATOR_GITHUB_BASE=main
# Optional until L2 control testing. Use a fine-grained GitHub token scoped only to this repo with Contents read/write.
# Never commit or expose the value.
GITHUB_OPERATOR_TOKEN=
# Optional registry metadata; does not grant Vercel API access.
RMF_OPERATOR_VERCEL_PROJECT_ID=prj_8Hcc7p9oYz8fDvp7uYChwMDEFr94

# Social provider OAuth. User-authorized only. Never scrape. Never commit real secrets.
# Instagram / LinkedIn stay 501 not_configured until both values exist.
# INSTAGRAM_OAUTH_CLIENT_ID=
# INSTAGRAM_OAUTH_CLIENT_SECRET=
# LINKEDIN_OAUTH_CLIENT_ID=
# LINKEDIN_OAUTH_CLIENT_SECRET=
# TikTok Login Kit (Vercel Sensitive). Redirect: https://ratemyface.vercel.app/api/providers/tiktok/callback
TIKTOK_OAUTH_CLIENT_KEY=
TIKTOK_OAUTH_CLIENT_SECRET=
# Optional override; defaults to production callback above.
# TIKTOK_OAUTH_REDIRECT_URI=https://ratemyface.vercel.app/api/providers/tiktok/callback
# Optional dedicated AES key for token_ref; otherwise derived from TIKTOK_OAUTH_CLIENT_SECRET.
# RMF_TOKEN_ENCRYPTION_KEY=
