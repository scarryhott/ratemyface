# Server-side only. Never expose these with NEXT_PUBLIC_ prefixes.
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
GPT_ACTION_SECRET=

# Rate My Face OAuth bridge
RMF_OAUTH_CLIENT_ID=ratemyface-chatgpt
RMF_OAUTH_CLIENT_SECRET=
CHATGPT_OAUTH_REDIRECT_URI=

# Supabase / Postgres (normally injected by the Vercel integration)
DATABASE_URL=
POSTGRES_URL=
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe billing — server-side only
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_CREDITS=
RMF_CREDITS_PER_PACK=100
STRIPE_PRICE_ID_PREMIUM=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
STRIPE_PORTAL_RETURN_URL=

# Rate My Face Operator — Vercel AI Gateway + bounded heartbeat/signals
AI_GATEWAY_API_KEY=
RMF_OPERATOR_MODEL=openai/gpt-5.6-terra
# Starts analysis-only. Raise only after ledger evidence validates controls.
RMF_OPERATOR_MAX_AUTHORITY=1
# Random bearer secret for external/email/manual signal ingress and status reads.
RMF_OPERATOR_SIGNAL_SECRET=
# Vercel Cron bearer secret used for the heartbeat endpoint.
CRON_SECRET=
